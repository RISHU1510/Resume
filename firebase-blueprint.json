{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile synchronized upon Google authentication",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User full name" },
        "photoURL": { "type": "string", "description": "User avatar profile image URL" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "lastLogin": { "type": "string", "description": "ISO timestamp of last sign-in" }
      },
      "required": ["id", "email"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User bookmarked portfolio project or case study",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique bookmark identifier" },
        "userId": { "type": "string", "description": "UID of owner" },
        "projectId": { "type": "string", "description": "Identifier of bookmarked project" },
        "createdAt": { "type": "string", "description": "Timestamp of bookmarking" }
      },
      "required": ["id", "userId", "projectId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document accessible and manageable by the authenticated owner"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "Collection of portfolio projects bookmarked by the user"
    }
  }
}
